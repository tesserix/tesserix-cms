{
  "name": "tesserix-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "test": "vitest run",
    "migrate": "payload migrate",
    "migrate:check": "payload migrate:create schema-drift --skip-empty && test -z \"$(git status --porcelain -- src/migrations)\" || (echo \"Schema changed without a migration: run npm run migrate:create <name> and commit it.\" && exit 1)",
    "seed:yes-hospital": "payload run scripts/seed-yes-hospital.ts",
    "seed:tesserix": "payload run scripts/seed-tesserix.ts",
    "create-super-admin": "payload run scripts/create-super-admin.ts",
    "migrate:create": "payload migrate:create"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-multi-tenant": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-gcs": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.18",
    "happy-dom": "21.0.4",
    "@google-cloud/storage": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
